# The daily surface-usage reading, filed onto a packet (backlog 628f182b).
#
# David, 2026-09-16: "let's measure which surfaces I open for a week."
# Every client-side navigation in the SPA is one row in `surface_opens`
# on the jobs API; this unit rolls the last 24 hours up per actor per
# route, names the catalogued surfaces nobody opened, sweeps rows past
# retention, and PATCHes the reading onto the open
# `maintenance-surface-usage` packet.
#
# WHY THIS HOST. The roll-up is one read of the jobs API and could run
# anywhere; the never-opened comparison needs the nav catalog
# (apps/web/src/shell/nav-catalog.ts), which is a file in the tree, and
# this is the box that keeps a checkout current — boss-gcp-converge
# fetches forge main into /opt/boss every thirty minutes. Same host for
# the same reason as boss-codebase-metrics and boss-protocol-drift, and
# the same role (off-cluster-observer) so the converge installs it.
#
# THE SYSTEM OF RECORD, PINNED INLINE WITH env(1) on every line that
# speaks to it — the rule timers-leave-a-packet check 7 states, learned
# from the estate observers (91ddebfb) and boss-codebase-metrics: a
# drop-in outranks unit Environment=, and a chore filed on an instance
# nobody reads is a chore that did not run.
#
# ExecStartPre=- because the packet is VISIBILITY, NEVER A PRECONDITION
# — and here, as for codebase-metrics, the packet is also where the
# work LANDS: if the API is unreachable the wrap exits 0 and lets the
# run proceed, the run then finds no open packet, prints the whole
# reading to the journal and exits non-zero. Nothing is lost to a
# reduction (CLAUDE.md §Diagnosis), and the failed unit is a state
# somebody notices.
#
# AS THE CHECKOUT'S OWNER, like its two siblings: git reads /opt/boss
# for the catalog's head, and git refuses a repository owned by
# somebody else ("dubious ownership") — boss-codebase-metrics exited 3
# on its first-ever firing for exactly this (2026-09-12 05:14Z).
[Unit]
Description=BOSS daily surface usage (which surfaces each operator opened; never-opened catalog paths)
Documentation=file:/opt/boss/infra/surface-usage.sh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# One roll-up read, one sweep, one PATCH: seconds. The ceiling is for
# a contended box and the transport's deploy-roll retry, not the work.
TimeoutStartSec=10min
User=david
ExecStartPre=-/usr/bin/env BOSS_JOBS_URL=http://10.20.0.34:7900 /opt/boss/infra/boss-maintenance-wrap.sh maintenance-surface-usage "Surface usage"
ExecStart=/usr/bin/env BOSS_JOBS_URL=http://10.20.0.34:7900 /opt/boss/infra/surface-usage.sh file --repo /opt/boss
ExecStopPost=-/usr/bin/env BOSS_JOBS_URL=http://10.20.0.34:7900 /opt/boss/infra/boss-step.sh maintenance-surface-usage run
