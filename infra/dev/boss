#!/usr/bin/env bash
# boss — the BOSS CLI on the dev pod's PATH.
#
# The pod image ships no `boss`; the binary is a build artifact in
# CARGO_TARGET_DIR (/scratch/target), so a bare shell — and David's
# `!` prompt in a session — could not find it (2026-09-07 23:05 UTC,
# a train cancel that mattered). This shim execs the built binary and
# defaults BOSS_JOBS_URL to the system of record, the way the
# conductor's unit does.
#
# Why it lives HERE and not only on the pod (backlog f199c188,
# 2026-09-14): it was pod-local text under /work/tools/bin —
# unversioned, untested, absent from any fresh pod or builder pod —
# and it decides WHICH binary answers every `boss` verb; a stale one
# answered `boss --version` wrong through it once already. Same shape
# as wt-cargo (34b29b52) and boss-api (0d8d7a90): the file is
# versioned and pinned (crates/core/boss-testing/tests/boss_shim_sh.rs),
# and the pod's /work/tools/bin/boss is a symlink to this file in the
# operator's checkout. The pod copy is the spec; behaviour is
# unchanged.
#
# Which binary wins: THE NEWER of target/release/boss and
# target/debug/boss, by mtime. The pod copy took release first in a
# fixed order, which is exactly the mechanism by which a stale binary
# answered `boss --version` wrong (the built_from car, 2026-09-14): a
# release build from days ago would beat this morning's debug build
# forever. The pod builds debug; a release build is the exception and
# wins only while it is the fresher one. The root (/scratch on the pod)
# is overridable so the test never touches it:
#   BOSS_SHIM_TARGET_ROOT=/some/dir boss --version
#
# The system of record has ONE spelling, in `sor-url` beside this
# script (boss-api reads the same file); readlink -f because the pod
# reaches this through a symlink. A caller's BOSS_JOBS_URL is kept.
here="$(dirname "$(readlink -f "$0")")"
if [ -z "${BOSS_JOBS_URL:-}" ]; then
  if [ -s "$here/sor-url" ]; then
    BOSS_JOBS_URL="$(tr -d '[:space:]' < "$here/sor-url")"
  else
    echo "boss: BOSS_JOBS_URL is unset and $here/sor-url names no system of record — a copy of this shim without its sor-url has no default" >&2
    exit 2
  fi
fi
export BOSS_JOBS_URL
target="${BOSS_SHIM_TARGET_ROOT:-/scratch}/target"
newest=""
for b in "$target/release/boss" "$target/debug/boss"; do
  [ -x "$b" ] || continue
  if [ -z "$newest" ] || [ "$b" -nt "$newest" ]; then newest="$b"; fi
done
[ -n "$newest" ] && exec "$newest" "$@"
echo "boss: no built binary under $target — run: cargo build -p boss-cli" >&2
exit 127
