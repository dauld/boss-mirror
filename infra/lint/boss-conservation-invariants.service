[Unit]
Description=Boss — conservation-invariant sweep
Documentation=https://github.com/algedonic-dev/boss/blob/main/docs/design/correctness-protocol.md
After=postgresql.service
Wants=postgresql.service

[Service]
EnvironmentFile=/etc/boss/sor.env
Type=oneshot
User=boss
Environment=PGPASSWORD=boss
# Packet filed on the system of record (/etc/boss/sor.env, above),
# best-effort: a bundle-only kind that the old local drop-in target had
# never heard of (400 every hour until 2026-09-08; see
# boss-ml-inference-batch.service, e109f57e).
ExecStartPre=-/opt/boss/infra/boss-maintenance-wrap.sh maintenance-conservation-invariants "Conservation-invariant sweep"
ExecStart=/opt/boss/infra/lint/conservation-invariants.sh
ExecStopPost=-/opt/boss/infra/boss-step.sh maintenance-conservation-invariants run
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
